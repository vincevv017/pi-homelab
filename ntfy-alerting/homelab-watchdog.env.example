# Deploy to /etc/homelab-watchdog.env — mode 0600, root:root.
# Each node points at the OTHER node.
#
# On Pi 1:   PEER_FQDN="<pi2-hostname>.<tailnet>.ts.net"  PEER_NAME="pi2"
# On Pi 2:   PEER_FQDN="<pi1-hostname>.<tailnet>.ts.net"  PEER_NAME="pi1"

PEER_FQDN="<peer-hostname>.<tailnet>.ts.net"
PEER_NAME="peer"
WARN_DAYS=21
