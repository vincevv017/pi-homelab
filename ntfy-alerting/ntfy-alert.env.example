# Deploy to /etc/ntfy-alert.env — mode 0600, root:root. Never commit the real file.
#
# On the node that HOSTS ntfy, use loopback with validation disabled so the alert
# path does not depend on the certificate or the tailnet being healthy:
#   NTFY_ALERT_URL="https://127.0.0.1:8443/homelab_alerts"
#   NTFY_CURL_OPTS="-k"
#
# On any OTHER node, reach it over the tailnet normally:
#   NTFY_ALERT_URL="https://<hostname>.<tailnet>.ts.net/ntfy/homelab_alerts"
#   NTFY_CURL_OPTS=""

NTFY_ALERT_URL="https://<hostname>.<tailnet>.ts.net/ntfy/homelab_alerts"
NTFY_CURL_OPTS=""
NTFY_TOKEN="tk_REPLACE_ME"
